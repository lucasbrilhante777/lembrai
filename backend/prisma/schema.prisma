// Modelo de dados do Lembrai.
// Regras que o Prisma não sabe declarar (anti-sobreposição e CHECKs) ficam
// em SQL na migration — ver docs/adr/0001-prevencao-de-conflito-de-agenda.md.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELED
  NO_SHOW
}

/// Dono do negócio. É o único tipo de usuário com login no MVP.
model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  establishments Establishment[]
}

model Establishment {
  id        String   @id @default(uuid())
  name      String
  /// Usado na URL pública: /agenda/:slug
  slug      String   @unique
  /// Fuso IANA, ex.: America/Recife (ver ADR 0002)
  timezone  String   @default("America/Sao_Paulo")
  userId    String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  professionals Professional[]
  services      Service[]
  customers     Customer[]
  appointments  Appointment[]

  @@index([userId])
}

/// Quem atende (ex.: o barbeiro). Sem login no MVP.
model Professional {
  id              String   @id @default(uuid())
  name            String
  /// Desativar em vez de apagar: preserva o histórico de agendamentos.
  active          Boolean  @default(true)
  establishmentId String
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  establishment Establishment         @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  services      ProfessionalService[]
  workingHours  WorkingHours[]
  appointments  Appointment[]

  @@index([establishmentId])
}

model Service {
  id              String   @id @default(uuid())
  name            String
  durationMinutes Int
  /// Em centavos: inteiro não tem erro de arredondamento (R$ 35,00 = 3500).
  priceCents      Int
  active          Boolean  @default(true)
  establishmentId String
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  establishment Establishment         @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  professionals ProfessionalService[]
  appointments  Appointment[]

  @@index([establishmentId])
}

/// Quais serviços cada profissional realiza (N:N).
model ProfessionalService {
  professionalId String
  serviceId      String

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([professionalId, serviceId])
  @@index([serviceId])
}

/// Expediente semanal, no horário LOCAL do estabelecimento (ver ADR 0002).
/// Mais de uma linha no mesmo dia = intervalo (ex.: 09:00–12:00 e 13:00–18:00).
model WorkingHours {
  id             String @id @default(uuid())
  professionalId String
  /// 0 = domingo ... 6 = sábado
  dayOfWeek      Int
  /// "HH:MM", ex.: "09:00"
  startTime      String
  /// "HH:MM", ex.: "18:00"
  endTime        String

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId, dayOfWeek])
}

/// Cliente final. Não tem login: é identificado pelo e-mail dentro de cada estabelecimento.
model Customer {
  id              String   @id @default(uuid())
  name            String
  email           String
  /// Coletado desde o MVP para o lembrete por WhatsApp no futuro.
  phone           String
  establishmentId String
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  appointments  Appointment[]

  @@unique([establishmentId, email])
}

model Appointment {
  id                  String            @id @default(uuid())
  establishmentId     String
  professionalId      String
  serviceId           String
  customerId          String
  /// Sempre em UTC (ver ADR 0002)
  startAt             DateTime          @db.Timestamptz(3)
  endAt               DateTime          @db.Timestamptz(3)
  /// Preço no momento do agendamento: mudar o preço do serviço não altera o histórico.
  priceCentsAtBooking Int
  status              AppointmentStatus @default(SCHEDULED)
  /// Token aleatório do link "cancelar agendamento" enviado por e-mail.
  cancelToken         String            @unique
  /// Preenchido quando o lembrete é enviado: garante que ele não seja enviado duas vezes.
  reminderSentAt      DateTime?         @db.Timestamptz(3)
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(3)

  // Apagar o estabelecimento apaga a agenda dele. Já profissional, serviço e cliente
  // com agendamentos não podem ser apagados (NoAction): o certo é desativar.
  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  professional  Professional  @relation(fields: [professionalId], references: [id], onDelete: NoAction)
  service       Service       @relation(fields: [serviceId], references: [id], onDelete: NoAction)
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: NoAction)

  @@index([establishmentId, startAt])
  @@index([status, startAt])
}

# Copie este arquivo para .env e ajuste os valores.
NODE_ENV=development
PORT=3333
FRONTEND_URL=http://localhost:5173

# Mesmo usuário/senha/banco do docker-compose.yml
DATABASE_URL=postgresql://lembrai:lembrai@localhost:5432/lembrai

# Segredo que assina os tokens de login (mínimo 32 caracteres). Gere um com:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-32-caracteres-ou-mais
